# SepsisGuardian AI — Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Groq LLM ──────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# A verified available model. Change if the default is unavailable.
# Run `python -c "from groq import Groq; import os; c=Groq(api_key=os.environ['GROQ_API_KEY']); print([m.id for m in c.models.list().data])"` to see available models.
GROQ_MODEL=llama3-8b-8192
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_TOKENS=1200

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Model Storage ─────────────────────────────────────────────────────────────
# Relative to backend/ directory
MODELS_DIR=models_store

# ── Dataset Paths (relative to project root) ──────────────────────────────────
DATASET_ROOT=..
SEPSIS_CSV=../synthetic_sepsis_training.csv
AKI_CSV=../synthetic_aki_training.csv
CARDIO_CSV=../synthetic_cardiovascular_risk_training.csv
LIVER_CSV=../synthetic_liver_risk_training.csv
NEURO_CSV=../synthetic_neurological_risk_training.csv
RESP_CSV=../synthetic_respiratory_risk_training.csv
ANTIBIOTIC_CSV=../synthetic_antibiotic.csv

# ── Security ──────────────────────────────────────────────────────────────────
# Change in production. Used to sign JWT tokens for demo auth.
SECRET_KEY=change-this-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
